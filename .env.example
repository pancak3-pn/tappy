# Supabase server credentials
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_SECRET_KEY

# Tappy admin access
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_TOKEN_SECRET=generate-a-different-long-random-secret

# Resend email delivery
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM=Tappy <onboarding@resend.dev>

# Protected payment reminder job (use the same value in Supabase Vault)
CRON_SECRET=generate-a-long-random-secret
PAYMENT_REMINDER_AFTER_MINUTES=45

# Local API server only. Vercel assigns its own port.
PORT=8787

# Sentry error monitoring (optional; leave blank to disable locally)
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
PUBLIC_SITE_URL=https://www.tappycard.tech

# Optional: readable production stack traces (server/build secrets; never prefix with VITE_)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
